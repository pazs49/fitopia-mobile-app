# =====================================================================
# Fitopia - Environment Configuration (EXAMPLE / REFERENCE)
# =====================================================================
#
# These values were previously HARDCODED in
#   lib/presentation/resources/strings_manager.dart
# and have been removed from the source code for handover.
#
# The app now reads them at build/run time via --dart-define.
# Copy this file, fill in the real values for your environment,
# and pass them on the command line (see HANDOVER.md > "Running").
#
# NOTE: These are the values that existed in the code before handover.
#       Confirm/replace them with your own backend before going live.
# ---------------------------------------------------------------------

# Base URL of the backend API (must end with a trailing slash)
APP_BASE_URL=https://medeaminds.com/

# Base URL used for loading uploaded images
IMG_BASE_URL=https://medeaminds.com/uploads
